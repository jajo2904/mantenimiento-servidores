<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mantenimiento.servidores.PanelPrincipalController" prefWidth="760" prefHeight="420" minWidth="680" minHeight="390" spacing="10" stylesheets="@panel.css" styleClass="panel-estandar">
 <padding><Insets top="20" right="22" bottom="18" left="22"/></padding>
 <HBox alignment="CENTER_LEFT" spacing="12"><Label text="RECREAR PORTALES" styleClass="title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="UsuarioLabel" styleClass="inicio-usuario" minWidth="0"/></HBox>
 <Label text="Seleccione los portales a recrear."/>
 <HBox spacing="18" VBox.vgrow="ALWAYS" minHeight="0">
  <VBox spacing="6" minWidth="170" prefWidth="170">
    <CheckBox fx:id="portal001Check" text="SVR-APL-001" mnemonicParsing="false"/>
    <CheckBox fx:id="portal002Check" text="SVR-APL-002" mnemonicParsing="false"/>
    <CheckBox fx:id="portal003Check" text="SVR-APL-003" mnemonicParsing="false"/>
    <CheckBox fx:id="portal004Check" text="SVR-APL-004" mnemonicParsing="false"/>
    <CheckBox fx:id="portal005Check" text="SVR-APL-005" mnemonicParsing="false"/>
    <CheckBox fx:id="portal006Check" text="SVR-APL-006" mnemonicParsing="false"/>
    <CheckBox fx:id="portal012Check" text="SVR-APL-012" mnemonicParsing="false"/>
    <CheckBox fx:id="portal015Check" text="SVR-APL-015" mnemonicParsing="false"/>
    <CheckBox fx:id="portal024Check" text="SVR-APL-024" mnemonicParsing="false"/>
    <Separator/>
    <CheckBox fx:id="seleccionarTodoCheck" onAction="#seleccionarTodos" text="Seleccionar todos" minWidth="170"/>
  </VBox>
  <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="0">
   <Label text="Resultados" style="-fx-font-weight: bold;"/>
   <Label fx:id="EstadoLabel" text="Listo para ejecutar." maxWidth="Infinity" minHeight="20" prefHeight="20" maxHeight="20"/>
   <TextArea fx:id="HistorialArea" editable="false" wrapText="true" prefRowCount="8" prefColumnCount="40" minHeight="80" VBox.vgrow="ALWAYS"/>
  </VBox>
 </HBox>
 <HBox spacing="12"><Button fx:id="EjecutarButton" text="Ejecutar" onAction="#ejecutar" prefWidth="140" styleClass="button, inicio-opcion" prefHeight="38"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="VolverButton" text="Volver a Panel Inicio" onAction="#volverMenu" styleClass="button, inicio-salir" prefHeight="38"/></HBox>
</VBox>
