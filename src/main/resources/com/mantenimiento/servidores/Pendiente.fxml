 <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
 <HBox alignment="CENTER_LEFT"><Label fx:id="tituloLabel" styleClass="title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="usuarioLabel"/></HBox>
